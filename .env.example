# Telegram API credentials
# Получить на https://my.telegram.org/auth?to=apps
TG_API_ID=
TG_API_HASH=

# Номер телефона аккаунта-юзербота (отдельный, не личный!)
TG_PHONE=

# ID чата для мониторинга (числовой, начинается с -100 для групп/каналов)
# Список доступных чатов после авторизации: ./scripts/bootstrap.sh --chats
TG_CHAT_IDS=
